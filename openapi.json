    "/documents/{document_id}/passages/{chunk_index}": {
      "get": {
        "description": "One passage of a document, what a citation in an answer points at.\n\nChecked against the document's own visibility first, so a passage of a\ndocument the caller can't see 404s the same way the document does.",
        "operationId": "get_passage_documents__document_id__passages__chunk_index__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
