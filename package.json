{
  "name": "bibliolegis-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 4000",
    "generate-routes": "tsr generate",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "api:sync": "cp ../bibliolegis-api/openapi.json openapi.json && pnpm api:types",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.56",
    "nitro": "3.0.260610-beta",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
