# Where the FastAPI backend is running. The api repo's docker compose puts it
# on port 4444. Anything the browser reads has to start with VITE_.
VITE_API_URL=http://localhost:4444

# Clerk. Pull the real values rather than pasting them:
#   clerk env pull --app app_3JeKtVK5lZdHKYWcSXVqv0cT5i2 --instance dev --file .env.local
# That writes both of these to .env.local, which is gitignored. The publishable
# key is fine in browser code. The secret key is read only on the server by
# clerkMiddleware and must never get a VITE_ prefix, or it ships in the bundle.
# VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# PostHog, for analytics, error tracking and session replay. Left empty here so
# local development sends nothing. The project is on PostHog's EU cloud and the
# host defaults to it. The key is a project key, meant to be in browser code.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
